# GateKeeperAI environment template. `gatekeeper init` creates .env for you; this file documents
# the names. Only .env.example is committed; .env is git-ignored. Names here, never real values.

# --- Required for the local (stdio) gateway ----------------------------------
# Key for the ledger's keyed-HMAC hash chain. `gatekeeper init` generates one.
GATEKEEPER_HMAC_KEY=
# Retired chain keys, comma-separated. `gatekeeper rotate-key` fills this in. Keep them: without
# the key that signed a record, that record can never be verified again.
# GATEKEEPER_HMAC_KEY_PREVIOUS=
# Token the stdio gateway presents on the agent's behalf; must match config/identities.yaml.
# `gatekeeper init` writes the demo operator token.
GATEKEEPER_AGENT_TOKEN=

# --- Governed servers that need a credential ----------------------------------
# upstreams.yaml references a secret by NAME with { from_env: NAME }; put the value here.
# GITHUB_TOKEN=

# --- Optional -------------------------------------------------------------------
# Webhook for verify-failure / deny-spike alerts (Slack, Teams, PagerDuty). Unset = off.
# GATEKEEPER_ALERT_WEBHOOK=
# Where held writes are announced, so approvers hear about them instead of watching the desk.
# Any Slack/Teams incoming webhook. Unset = falls back to GATEKEEPER_ALERT_WEBHOOK.
# GATEKEEPER_APPROVAL_WEBHOOK=
# The desk's URL, put into those messages so they are one click from a decision.
# GATEKEEPER_DESK_URL=https://gatekeeper.example.com/ui
# GATEKEEPER_LOG_LEVEL=INFO
# Absolute path to the config folder (set this when an MCP host launches the gateway).
# GATEKEEPER_CONFIG_DIR=/abs/path/gatekeeper/config

# --- Hosted deployments (every knob in config/platform.yaml has one of these) ---
# GATEKEEPER_TRANSPORT=http
# GATEKEEPER_HTTP_HOST=0.0.0.0
# GATEKEEPER_HTTP_ALLOW_NON_LOOPBACK=1
# GATEKEEPER_HTTP_ALLOWED_HOSTS=gw.example.com
# GATEKEEPER_LEDGER_PATH=/data/audit.db
# The durable ledger: a managed Postgres database instead of the file above. Required for a hosted
# deployment (the file dies with the container) and for running more than one replica.
# GATEKEEPER_LEDGER_URL=postgresql://user:password@host:5432/gatekeeper?sslmode=require
# GATEKEEPER_IDENTITIES=operator:operator:<token>;readonly:readonly:<token>
# GATEKEEPER_IDENTITY=oidc
# GATEKEEPER_OIDC_ISSUER=
# GATEKEEPER_OIDC_AUDIENCE=
# GATEKEEPER_OIDC_GROUP_ROLE_MAP=<group-id>=operator,<group-id>=readonly
